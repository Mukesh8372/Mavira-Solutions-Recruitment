# Postgres connection string (Neon). Never commit the real value.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"
AUTH_SECRET="dev-secret-change-in-production-9f8a7b6c5d4e3f2a1b0c"
AUTH_TRUST_HOST=true
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# --- Resume storage: one private Cloudflare R2 bucket (S3 API) ---
# Create the bucket with public access OFF, then an API token with
# "Object Read & Write" limited to that bucket. The secret is shown once.
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET="mavira-resumes"

# --- Daily cleanup job (/api/cron/cleanup-resumes) ---
# Long random string. The scheduler sends it as "Authorization: Bearer <CRON_SECRET>".
CRON_SECRET=""

# --- Admin account (used by prisma seed) ---
ADMIN_EMAIL="mukesh@mavirasolutions.com"
ADMIN_PASSWORD=""
